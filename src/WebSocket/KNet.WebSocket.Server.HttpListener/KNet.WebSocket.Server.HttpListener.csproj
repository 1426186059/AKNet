<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 与 TcpListener 保持一致：AssemblyName=KNet.WebSocket.Server，以便通过 KNet.Common 的 InternalsVisibleTo 访问内部编解码类 -->
    <AssemblyName>KNet.WebSocket.Server</AssemblyName>
    <RootNamespace>KNet.WebSocket.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\KNet.Common\KNet.Common.csproj" />
  </ItemGroup>

</Project>
